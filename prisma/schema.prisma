generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String       @id @default(cuid())
  name         String?
  phone        String?      @unique
  email        String?      @unique
  password     String
  role         Role         @default(USER)
  image        String?
  address      String?
  // اطلاعات تکمیلی — فقط مدیر پر می‌کند (در فرم ثبت‌نام مشتری نیست)
  nationalCode String?
  companyName  String?
  province     String?
  city         String?
  postalCode   String?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  orders       Order[]
  cartItems    CartItem[]
  preInvoices              PreInvoice[]
  approvedCogsAllocations  CogsAllocation[] @relation("CogsApprovedBy")
  rejectedCogsAllocations  CogsAllocation[] @relation("CogsRejectedBy")
  createdCustomerReceipts  CustomerReceipt[] @relation("CustomerReceiptCreatedBy")
  party        Party?

  @@index([isActive])

  @@map("users")
}

enum Role {
  USER
  ADMIN
}
model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  image       String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]
  order       Int        @default(0)
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("categories")
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  logo      String?
  website   String?
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("brands")
}

model Product {
  id             String                @id @default(cuid())
  name           String
  slug           String                @unique
  description    String?
  price          Float
  discountPrice  Float?
  stock          Int                   @default(0)
  sku            String?
  /// شماره کالا در نرم‌افزار حسابداری SHIK. کالاهای تاریخی که فقط برای نگه‌داری
  /// سابقه و اتصال به فاکتورها وارد شده‌اند active=false هستند و در سایت دیده
  /// نمی‌شوند، ولی چون کاتالوگ Access با کاتالوگ سایت اشتراک ندارد این کلید لازم است
  legacyGoodId   Int?                  @unique
  isMeter        Boolean?
  sourceUrl      String?
  featured       Boolean               @default(false)
  active         Boolean               @default(true)
  categoryId     String
  category       Category              @relation(fields: [categoryId], references: [id])
  brandId        String?
  brand          Brand?                @relation(fields: [brandId], references: [id])
  images         ProductImage[]
  priceHistory   ProductPriceHistory[]
  specifications String?
  orderItems     OrderItem[]
  cartItems      CartItem[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  prices         ProductPrice[]
  stockMovements StockMovement[]

  purchaseBatches   ProductPurchaseBatch[]
  cogsLines         CogsAllocationLine[]

  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  alt       String?
  isPrimary Boolean @default(false)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order     Int     @default(0)

  @@map("product_images")
}

model ProductPriceHistory {
  id            String    @id @default(cuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  price         Float
  discountPrice Float?
  validFrom     DateTime
  validUntil    DateTime?
  createdAt     DateTime  @default(now())

  @@index([productId, validFrom])
  @@map("product_price_history")
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  status          OrderStatus @default(PENDING)
  totalPrice      Float
  shippingAddress String?
  phone           String
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]

  @@map("orders")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float

  @@map("order_items")
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@map("cart_items")
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  image     String
  link      String?
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("banners")
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model PreInvoice {
  id              String        @id @default(cuid())
  userId          String?
  user            User?         @relation(fields: [userId], references: [id])
  invoiceNumber   Int           @unique
  customerName    String
  customerPhone   String
  address         String?
  items           Json
  totalPrice      Float
  status          String        @default("PENDING")
  notes           String?
  source          String        @default("ADMIN")
  // آخرین بار که مدیر فاکتور را دستی ویرایش کرد + زمانی که کاربر اعلان را دیده
  adminEditedAt   DateTime?
  adminEditSeenAt DateTime?
  salesInvoice    SalesInvoice?
  createdAt       DateTime      @default(now())

  @@index([userId, adminEditedAt])
  customerReceipts CustomerReceipt[]
  cogsAllocation   CogsAllocation?

  @@map("pre_invoices")
}

// ═══════════════════════════════════════════════════════════════════
//  حسابداری
//  داده‌ها از نرم‌افزار SHIK (Access) وارد شده‌اند؛ همهٔ مبالغ به «تومان»
//  و تاریخ‌ها به شمسی «YYYY/MM/DD» ذخیره می‌شوند (هم‌عرض، پس ترتیب
//  لغوی = ترتیب زمانی). legacyId کلید تطبیق با فایل Access است تا ایمپورت
//  دوباره رکورد تکراری نسازد.
// ═══════════════════════════════════════════════════════════════════

/// طرف حساب — مشتری و تأمین‌کننده. `kind` تعیین می‌کند در کدام فاکتورها ظاهر شود.
model Party {
  id             String   @id @default(cuid())
  legacyId       Int?     @unique
  name           String
  kind           String   @default("CUSTOMER") // CUSTOMER | SUPPLIER | BOTH
  phone          String?
  address        String?
  nationalCode   String?
  postalCode     String?
  city           String?
  province       String?
  bankName       String?
  bankBranch     String?
  bankAccount    String?
  /// مانده اول دوره به تومان؛ مثبت = ما طلبکاریم، منفی = ما بدهکاریم
  openingBalance Float    @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user   User?   @relation(fields: [userId], references: [id])
  userId String? @unique

  salesInvoices    SalesInvoice[]
  purchaseInvoices PurchaseInvoice[]
  cashMovements    CashMovement[]
  cheques          Cheque[]
  ledgerEntries    LedgerEntry[]

  @@index([name])
  @@index([kind])
  supplierBatches  ProductPurchaseBatch[] @relation("SupplierBatches")
  customerReceipts CustomerReceipt[]

  @@map("parties")
}

model SalesInvoice {
  id           String      @id @default(cuid())
  legacyId     Int?        @unique
  number       Int
  date         String
  deliveryDate String?
  discount     Float       @default(0)
  total        Float
  status       String      @default("DONE") // DONE | CANCELLED
  note         String?
  /// اگر از پیش‌فاکتور سایت ساخته شده باشد
  preInvoice   PreInvoice? @relation(fields: [preInvoiceId], references: [id])
  preInvoiceId String?     @unique
  createdAt    DateTime    @default(now())

  party   Party?             @relation(fields: [partyId], references: [id])
  partyId String?
  lines   SalesInvoiceLine[]

  @@index([date])
  @@index([partyId])
  @@map("sales_invoices")
}

model SalesInvoiceLine {
  id           String       @id @default(cuid())
  invoiceId    String
  invoice      SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position     Int
  name         String
  quantity     Float
  unitPrice    Float
  discount     Float        @default(0)
  total        Float
  productId    String?
  legacyGoodId Int?

  @@index([invoiceId])
  @@map("sales_invoice_lines")
}

model PurchaseInvoice {
  id           String   @id @default(cuid())
  legacyId     Int?     @unique
  number       Int
  date         String
  deliveryDate String?
  discount     Float    @default(0)
  total        Float
  status       String   @default("DONE")
  note         String?
  createdAt    DateTime @default(now())

  party   Party?                @relation(fields: [partyId], references: [id])
  partyId String?
  lines   PurchaseInvoiceLine[]

  @@index([date])
  @@index([partyId])
  purchaseBatches  ProductPurchaseBatch[]

  @@map("purchase_invoices")
}

model PurchaseInvoiceLine {
  id           String          @id @default(cuid())
  invoiceId    String
  invoice      PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position     Int
  name         String
  quantity     Float
  unitPrice    Float
  discount     Float           @default(0)
  total        Float
  productId    String?
  legacyGoodId Int?

  @@index([invoiceId])
  @@map("purchase_invoice_lines")
}

/// دریافت (مشتری به ما) و پرداخت (ما به تأمین‌کننده) — هر دو در این جدول
model CashMovement {
  id        String   @id @default(cuid())
  /// شناسهٔ سند در فایل Access. دریافت‌ها و پرداخت‌ها هر دو از ۱ شماره‌گذاری
  /// شده‌اند، پس یکتایی باید همراه با kind باشد وگرنه روی هم می‌افتند
  legacyId  Int?
  kind      String // RECEIPT | PAYMENT
  date      String
  amount    Float
  discount  Float    @default(0)
  note      String?
  /// شمارهٔ سند در فایل Access (عملیات دریافت/پرداخت)
  voucher   Int?
  cashBox   CashBox? @relation(fields: [cashBoxId], references: [id])
  cashBoxId String?
  createdAt DateTime @default(now())

  party    Party?  @relation(fields: [partyId], references: [id])
  partyId  String?
  cheque   Cheque? @relation(fields: [chequeId], references: [id])
  chequeId String? @unique

  @@unique([kind, legacyId])
  @@index([date])
  @@index([kind])
  @@index([partyId])
  @@map("cash_movements")
}

/// گردش حساب طرف حساب (مانده اول دوره + فاکتورها + دریافت/پرداخت)
model LedgerEntry {
  id          String  @id @default(cuid())
  legacyId    Int?    @unique
  /// برای ردیف‌های «موجودی اول دوره» تاریخی ثبت نشده، پس null می‌ماند
  date        String?
  /// کد نوع سند از فایل Access: ۰=مانده اول دوره، ۲۰=دریافت، ۲۵=پرداخت،
  /// ۳۰=فاکتور فروش، ۳۱=تخفیف فروش، ۴۰=فاکتور خرید، ۴۱=تخفیف خرید
  voucherType Int
  voucher     Int     @default(0)
  /// به تومان؛ قرارداد فایل Access: منفی = طرف حساب به ما بدهکار است
  amount      Float
  description String?

  party   Party  @relation(fields: [partyId], references: [id], onDelete: Cascade)
  partyId String
  /// منبع سند: ACCESS = حسابداری قدیم، NEW = حسابداری جدید
  source  String @default("ACCESS")

  @@index([partyId, date])
  @@index([source])
  customerReceipt  CustomerReceipt?
  cogsAllocation   CogsAllocation?

  @@map("ledger_entries")
}

model Cheque {
  id          String   @id @default(cuid())
  legacyId    Int?     @unique
  number      String?
  amount      Float
  /// تاریخ ثبت در سیستم
  issuedDate  String?
  /// تاریخ سررسید
  dueDate     String
  bankName    String?
  bankBranch  String?
  bankAccount String?
  bookSerial  String?
  /// کد وضعیت در فایل Access (۲، ۱۳، ۱۵). معنی این کدها در هیچ جدولی
  /// ثبت نشده، پس از وب قابل تغییر است
  status      Int?
  statusNote  String?
  isSettled   Boolean  @default(false)
  settledDate String?
  note        String?
  /// چک‌های قدیمی فایل Access که جدیدتر از آن‌ها شماره‌گذاری یکسان ندارند
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  party    Party?        @relation(fields: [partyId], references: [id])
  partyId  String?
  movement CashMovement?

  @@index([dueDate])
  @@index([isSettled])
  @@map("cheques")
}

model CashBox {
  id             String         @id @default(cuid())
  legacyId       Int?           @unique
  name           String
  /// موجودی اول دوره به تومان (در فایل Access منفی ذخیره شده و ما مثبت می‌کنیم)
  openingBalance Float          @default(0)
  movements      CashMovement[]

  @@map("cash_boxes")
}

model BankAccount {
  id             String  @id @default(cuid())
  legacyId       Int?    @unique
  name           String
  branch         String?
  account        String?
  sheba          String?
  cardNumber     String?
  openingBalance Float   @default(0)

  @@map("bank_accounts")
}

model Warehouse {
  id        String          @id @default(cuid())
  legacyId  Int?            @unique
  name      String
  movements StockMovement[]

  @@map("warehouses")
}

/// لیست قیمت چندسطحی هر کالا (CashList در فایل Access)
model PriceLevel {
  id        String         @id @default(cuid())
  legacyId  Int?           @unique
  name      String
  costType  Int            @default(0)
  isDefault Boolean        @default(false)
  prices    ProductPrice[]

  @@map("price_levels")
}

model ProductPrice {
  id        String     @id @default(cuid())
  level     PriceLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)
  levelId   String
  productId String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// قیمت به تومان
  price     Float

  @@unique([levelId, productId])
  @@map("product_prices")
}

/// کارتکس انبار — حرکات ورود و خروج هر کالا
model StockMovement {
  id            String  @id @default(cuid())
  legacyId      Int?    @unique
  date          String
  /// مثبت = ورود، منفی = خروج (قرارداد فایل Access)
  quantity      Float
  unitPrice     Float
  /// موجودی پس از این حرکت
  stock         Float
  /// میانگین موبینگ قیمت
  averagePrice  Float
  /// ۰=مانده اول دوره، ۱=ورود (فاکتور خرید)، ۲=خروج (فاکتور فروش)
  operationType Int
  /// نام کالا در لحظهٔ ثبت — کاتالوگ Access با کاتالوگ سایت اشتراک نامی
  /// ندارد، پس برای نمایش باید snapshot داشته باشیم
  name          String?
  note          String?

  product      Product?   @relation(fields: [productId], references: [id])
  productId    String?
  warehouse    Warehouse? @relation(fields: [warehouseId], references: [id])
  warehouseId  String?
  legacyGoodId Int?

  @@index([date])
  @@index([productId])
  @@map("stock_movements")
}

model ProductPurchaseBatch {
  id                String   @id @default(cuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id])
  supplierId        String
  supplier          Party    @relation("SupplierBatches", fields: [supplierId], references: [id])
  quantity          Float    @default(0)
  unitCost          Float    @default(0)
  remainingQty      Float    @default(0)
  date              String
  reference         String?
  purchaseInvoiceId String?
  purchaseInvoice   PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id])
  ledgerEntryId     String?
  note              String?
  status            String   @default("ACTIVE")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  cogsLines         CogsAllocationLine[]

  @@index([productId, date])
  @@index([supplierId])
  @@index([purchaseInvoiceId])
  @@map("product_purchase_batches")
}

model CustomerReceipt {
  id            String   @id @default(cuid())
  partyId       String
  party         Party    @relation(fields: [partyId], references: [id])
  preInvoiceId  String?
  preInvoice    PreInvoice? @relation(fields: [preInvoiceId], references: [id])
  amount        Float
  date          String
  method        String   @default("CASH")
  note          String?
  ledgerEntryId String?  @unique
  ledgerEntry   LedgerEntry? @relation(fields: [ledgerEntryId], references: [id])
  createdById   String?
  createdBy     User?    @relation("CustomerReceiptCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([partyId, date])
  @@index([preInvoiceId])
  @@map("customer_receipts")
}

model CogsAllocation {
  id             String    @id @default(cuid())
  preInvoiceId   String    @unique
  preInvoice     PreInvoice @relation(fields: [preInvoiceId], references: [id])
  status         String    @default("PENDING_APPROVAL")
  totalCogs      Float     @default(0)
  salesTotal     Float     @default(0)
  grossProfit    Float     @default(0)
  note           String?
  approvedById   String?
  approvedBy     User?     @relation("CogsApprovedBy", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  rejectedById   String?
  rejectedBy     User?     @relation("CogsRejectedBy", fields: [rejectedById], references: [id])
  rejectedAt     DateTime?
  rejectionNote  String?
  ledgerEntryId  String?   @unique
  ledgerEntry    LedgerEntry? @relation(fields: [ledgerEntryId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  lines          CogsAllocationLine[]

  @@index([status])
  @@map("cogs_allocations")
}

model CogsAllocationLine {
  id                  String   @id @default(cuid())
  allocationId        String
  allocation          CogsAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  preInvoiceItemIndex Int?
  productId           String?
  product             Product? @relation(fields: [productId], references: [id])
  nameSnapshot        String
  quantity            Float
  unitPrice           Float
  lineTotal           Float
  allocatedQty        Float
  unitCogs            Float
  cogsTotal           Float
  batchId             String?
  batch               ProductPurchaseBatch? @relation(fields: [batchId], references: [id])
  /// مصرف دقیق از هر بچ: [{ batchId, qty, unitCost }] — برای بازگردانی هنگام حذف
  batchUsage          Json?

  @@index([allocationId])
  @@index([productId])
  @@map("cogs_allocation_lines")
}